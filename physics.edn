;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a farm-logistics robot performs planting,
;; harvest, feeding-schedule and animal-condition data entry, household task
;; scheduling and seeds/feed/tools procurement coordination for subsistence
;; mixed crop and livestock farmers (ISCO 6330). It never performs farm labor
;; or handles animals. Its physical work is supply logistics: carrying a mixed
;; load of seed, feed and tools from the road drop-off to the homestead, and
;; lifting a tool box or seed bag onto the store shelf.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-6330"
 :cases
 [{:id :mixed-supplies-to-homestead
   :kind :transport
   :procedure "logistics robot carries a mixed load of seed, feed and tools 250 m along a dirt track to the homestead store"
   :params {:mass-kg 55.0 :distance-m 250.0 :v-max-mps 0.8 :a-max-mps2 0.25
            :brake-decel-mps2 0.5 :drive-force-n 140.0 :crr 0.06
            :cog-height-m 0.45 :support-half-length-m 0.30}
   :sweep {:param :payload-kg :values [10.0 30.0 60.0 90.0 130.0]}
   :quantity :cycle-time-s
   :limit {:max 480.0 :basis "estimate: one trip within 8 minutes so a whole delivery is stored within the household's morning"}
   :boundary {:lo 2.0 :hi 300.0}}
  {:id :toolbox-onto-store-shelf
   :kind :manipulator
   :procedure "arm lifts a tool box or seed bag from the robot's deck onto the homestead store shelf"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 5.0 :m2-kg 3.5
            :from [0.60 0.05] :to [0.25 0.70] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 8.0 12.0 20.0]}
   :quantity :peak-tau1-nm
   :limit {:max 100.0 :basis "estimate: continuous shoulder torque of a ~10 kg payload class arm"}
   :boundary {:lo 0.5 :hi 40.0}}]}
